# Admin UI / API token (at least 16 characters). Generate one: openssl rand -hex 24
ADMIN_TOKEN=

# Where the server listens. Keep 127.0.0.1 unless it sits behind a reverse proxy with TLS.
HOST=127.0.0.1
PORT=8790

# SQLite file for connectors, workflows, approvals and the run log.
DB_PATH=data/auto-middleware.sqlite

# How often polling triggers (MySQL new rows) are checked.
POLL_INTERVAL_MS=15000

# Any OpenAI-compatible chat endpoint. Used only while designing workflows.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Secrets referenced by connectors (connector config stores only these names):
# SHOP_DB_PASSWORD=
# GOOGLE_SA_JSON={"client_email":"...","private_key":"..."}

# Planned website adapter (not implemented yet).
ENABLE_WEBSITE_ADAPTER=0
